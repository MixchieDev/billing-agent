"<!doctype html><html><head><meta charset=utf8><meta name=viewport content=\"width=device-width,initial-scale=1,viewport-fit=cover\"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>\n<title>AR Specialist Onboarding</title>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap\">\n<style>\n/* Layout: a fixed top bar with three views (Start \u00b7 Walkthrough \u00b7 Handbook \u00b7 Checklist);\n   the walkthrough is a simulated app window with a coaching panel beside it. */\n:root {\n  --bg: #f6f5f1;          /* ledger paper, slightly warm */\n  --surface: #ffffff;\n  --surface-2: #edece6;\n  --fg: #1d1f1c;\n  --muted: #5f645d;\n  --line: #d9d8d0;\n  --accent: #0f6e63;      /* deep teal: calm collections, not alarm */\n  --accent-ink: #ffffff;\n  --accent-soft: #dbeeea;\n  --good: #1f7a3a;  --good-soft: #dcefe1;\n  --warn: #9a6400;  --warn-soft: #fbeccb;\n  --bad:  #b3261e;  --bad-soft: #f9dcd9;\n  --info-soft: #e3e8f4;\n  --font-body: \"IBM Plex Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif;\n  --font-mono: \"IBM Plex Mono\", ui-monospace, SFMono-Regular, Menlo, monospace;\n}\n@media (prefers-color-scheme: dark) { :root:not([data-theme=\"light\"]) {\n  --bg: #15171a; --surface: #1e2125; --surface-2: #272b30; --fg: #e9eae6; --muted: #a2a79f; --line: #353a40;\n  --accent: #5fc4b5; --accent-ink: #0d2b27; --accent-soft: #1b3a36;\n  --good: #7ad194; --good-soft: #1d3a27; --warn: #f0c24b; --warn-soft: #3d3215; --bad: #ff8a80; --bad-soft: #432220; --info-soft: #262e3f;\n  color-scheme: dark;\n} }\n:root[data-theme=\"dark\"] {\n  --bg: #15171a; --surface: #1e2125; --surface-2: #272b30; --fg: #e9eae6; --muted: #a2a79f; --line: #353a40;\n  --accent: #5fc4b5; --accent-ink: #0d2b27; --accent-soft: #1b3a36;\n  --good: #7ad194; --good-soft: #1d3a27; --warn: #f0c24b; --warn-soft: #3d3215; --bad: #ff8a80; --bad-soft: #432220; --info-soft: #262e3f;\n  color-scheme: dark;\n}\n* { box-sizing: border-box; }\nbody { background: var(--bg); color: var(--fg); font-family: var(--font-body); font-size: 15px; line-height: 1.55; }\nbody::before { content: \"\"; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); z-index: 10; background: var(--surface); }\nh1, h2, h3, h4 { font-family: var(--font-body); line-height: 1.2; text-wrap: balance; margin: 0; }\nh1 { font-size: 2rem; font-weight: 700; letter-spacing: -0.01em; }\nh2 { font-size: 1.35rem; font-weight: 600; }\nh3 { font-size: 1.05rem; font-weight: 600; }\np { margin: 0; }\na { color: var(--accent); }\nbutton { font: inherit; cursor: pointer; }\n.num { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }\n\n/* top bar */\n.topbar { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 5; background: var(--surface); border-bottom: 1px solid var(--line);\n  padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }\n.topbar-in { max-width: 1180px; margin: 0 auto; display: flex; align-items: center; gap: 18px; flex-wrap: wrap; padding-block: 10px; }\n.brand { font-weight: 700; letter-spacing: 0.01em; }\n.brand small { display: block; font-weight: 500; color: var(--muted); font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; }\n.tabs { display: flex; gap: 4px; flex-wrap: wrap; margin-left: auto; }\n.tabs a { text-decoration: none; color: var(--muted); padding: 7px 12px; border-radius: 6px; font-weight: 500; }\n.tabs a[aria-current=\"page\"] { background: var(--accent-soft); color: var(--accent); }\n.tabs a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }\n\nmain { padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); padding-block: 28px 64px; }\n.wrap { max-width: 1180px; margin: 0 auto; }\n.prose { max-width: 68ch; }\n.prose p + p { margin-top: 0.8em; }\n.view[hidden] { display: none; }\n\n/* start */\n.hero { display: grid; gap: 28px; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); align-items: start; }\n@media (max-width: 820px) { .hero { grid-template-columns: 1fr; } }\n.eyebrow { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }\n.lede { font-size: 1.1rem; color: var(--muted); max-width: 60ch; }\n.notice { border: 1px solid var(--line); border-left: 4px solid var(--accent); background: var(--surface); padding: 14px 16px; border-radius: 6px; }\n.paths { display: grid; gap: 12px; }\n.path { display: block; text-decoration: none; color: inherit; background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 16px 18px; }\n.path:hover { border-color: var(--accent); }\n.path strong { display: block; font-size: 1.05rem; }\n.path span { color: var(--muted); font-size: 0.95rem; }\n.path em { font-style: normal; color: var(--accent); font-weight: 600; font-size: 0.85rem; }\n\n/* walkthrough */\n.wt { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 20px; align-items: start; }\n@media (max-width: 980px) { .wt { grid-template-columns: 1fr; } .coach { order: -1; } }\n.app { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; overflow: hidden; min-width: 0; }\n.app-head { display: flex; align-items: center; gap: 10px; padding: 8px 14px; border-bottom: 1px solid var(--line); background: var(--surface-2); font-size: 0.8rem; color: var(--muted); }\n.dots span { display: inline-block; width: 9px; height: 9px; border-radius: 50%; background: var(--line); margin-right: 4px; }\n.sandbox-tag { margin-left: auto; background: var(--warn-soft); color: var(--warn); font-weight: 600; padding: 2px 8px; border-radius: 999px; font-size: 0.72rem; letter-spacing: 0.04em; text-transform: uppercase; }\n.app-body { display: grid; grid-template-columns: 200px minmax(0, 1fr); min-height: 480px; }\n@media (max-width: 680px) { .app-body { grid-template-columns: 1fr; } .side { border-right: 0; border-bottom: 1px solid var(--line); } .side nav { display: flex; flex-wrap: wrap; gap: 2px; } .side .grp { display: none; } }\n.side { border-right: 1px solid var(--line); padding: 10px 8px; background: var(--surface); }\n.side .grp { font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); padding: 10px 8px 4px; font-weight: 600; }\n.side button { display: block; width: 100%; text-align: left; background: none; border: 0; color: var(--fg); padding: 6px 8px; border-radius: 6px; font-size: 0.88rem; }\n.side button[aria-current=\"page\"] { background: var(--accent-soft); color: var(--accent); font-weight: 600; }\n.side button.hint { box-shadow: inset 0 0 0 2px var(--accent); }\n.pane { padding: 16px 18px; min-width: 0; }\n.pane-title { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; margin-bottom: 4px; }\n.pane-sub { color: var(--muted); font-size: 0.9rem; margin-bottom: 14px; }\n.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 10px; margin-bottom: 14px; }\n.stat { border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; }\n.stat b { display: block; font-size: 1.3rem; }\n.stat span { color: var(--muted); font-size: 0.78rem; }\n.subtabs { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 10px; }\n.subtabs button { border: 1px solid var(--line); background: var(--surface); border-radius: 6px; padding: 4px 10px; font-size: 0.82rem; color: var(--fg); }\n.subtabs button[aria-pressed=\"true\"] { background: var(--fg); color: var(--bg); border-color: var(--fg); }\n.tbl-wrap { overflow-x: auto; }\ntable { border-collapse: collapse; width: 100%; font-size: 0.88rem; }\nth { text-align: left; font-weight: 600; color: var(--muted); font-size: 0.74rem; letter-spacing: 0.05em; text-transform: uppercase; padding: 6px 8px; border-bottom: 1px solid var(--line); white-space: nowrap; }\ntd { padding: 9px 8px; border-bottom: 1px solid var(--line); vertical-align: top; }\ntd.r, th.r { text-align: right; }\n.client b { display: block; }\n.client small { color: var(--muted); }\n.pill { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: 0.74rem; font-weight: 600; white-space: nowrap; border: 1px solid transparent; }\n.pill.good { background: var(--good-soft); color: var(--good); }\n.pill.warn { background: var(--warn-soft); color: var(--warn); }\n.pill.bad { background: var(--bad-soft); color: var(--bad); }\n.pill.info { background: var(--info-soft); color: var(--fg); }\n.pill.line { border-color: var(--line); color: var(--muted); }\n.btn { border: 1px solid var(--line); background: var(--surface); color: var(--fg); border-radius: 6px; padding: 5px 10px; font-size: 0.82rem; font-weight: 500; white-space: nowrap; }\n.btn:hover { border-color: var(--fg); }\n.btn.primary { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }\n.btn.danger { color: var(--bad); }\n.btn.ghost { border-color: transparent; }\n.btn:disabled { opacity: 0.5; cursor: not-allowed; }\n.actions { display: flex; gap: 6px; justify-content: flex-end; flex-wrap: wrap; }\n.note { color: var(--muted); font-size: 0.8rem; }\n.empty { color: var(--muted); padding: 24px 0; text-align: center; font-size: 0.9rem; }\n\n/* in-pane dialogs (the viewer shows no confirm()) */\n.sheet { border: 1px solid var(--accent); background: var(--surface); border-radius: 8px; padding: 14px; margin: 10px 0 14px; display: grid; gap: 10px; }\n.sheet h4 { font-size: 0.95rem; }\n.sheet.danger { border-color: var(--bad); }\n.field { display: grid; gap: 4px; font-size: 0.85rem; }\n.field input, .field select, .field textarea { font: inherit; padding: 6px 8px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); color: var(--fg); min-width: 0; width: 100%; }\n.fields { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; }\n.sheet .actions { justify-content: flex-start; }\n.toast { background: var(--good-soft); color: var(--good); border-radius: 6px; padding: 8px 12px; font-size: 0.85rem; font-weight: 500; margin-bottom: 12px; }\n\n/* coach */\n.coach { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 16px; position: sticky; top: calc(env(safe-area-inset-top, 0px) + 64px); display: grid; gap: 12px; }\n.progress { display: flex; gap: 4px; }\n.progress i { flex: 1; height: 5px; border-radius: 3px; background: var(--line); }\n.progress i.done { background: var(--good); }\n.progress i.now { background: var(--accent); }\n.coach .step-no { font-size: 0.74rem; color: var(--muted); letter-spacing: 0.06em; text-transform: uppercase; font-weight: 600; }\n.coach h3 { font-size: 1.1rem; }\n.coach .why { color: var(--muted); font-size: 0.9rem; }\n.coach .task { background: var(--accent-soft); border-radius: 8px; padding: 10px 12px; font-size: 0.9rem; }\n.coach .task b { color: var(--accent); }\n.coach .done-msg { background: var(--good-soft); color: var(--good); border-radius: 8px; padding: 10px 12px; font-size: 0.9rem; }\n.coach-nav { display: flex; gap: 8px; flex-wrap: wrap; }\n.coach .learn { font-size: 0.85rem; color: var(--muted); border-top: 1px solid var(--line); padding-top: 10px; }\n.coach .learn ul { margin: 6px 0 0; padding-left: 18px; }\n.coach .learn li + li { margin-top: 3px; }\n\n/* handbook */\n.hb { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 32px; }\n@media (max-width: 820px) { .hb { grid-template-columns: 1fr; } .toc { position: static; } }\n.toc { position: sticky; top: calc(env(safe-area-inset-top, 0px) + 64px); align-self: start; font-size: 0.9rem; display: grid; gap: 2px; }\n.toc a { text-decoration: none; color: var(--muted); padding: 4px 8px; border-radius: 6px; }\n.toc a:hover { color: var(--accent); background: var(--accent-soft); }\n.doc { display: grid; gap: 40px; }\n.doc section { display: grid; gap: 12px; scroll-margin-top: 90px; }\n.doc section > p, .doc section > ul, .doc section > ol { max-width: 68ch; }\n.doc ul, .doc ol { margin: 0; padding-left: 22px; }\n.doc li + li { margin-top: 5px; }\n.doc table { font-size: 0.9rem; }\n.callout { border: 1px solid var(--line); border-radius: 8px; padding: 12px 14px; background: var(--surface); max-width: 68ch; }\n.callout.rule { border-left: 4px solid var(--bad); }\n.callout.tip { border-left: 4px solid var(--accent); }\n.ladder { display: grid; gap: 0; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; max-width: 68ch; }\n.rung { display: grid; grid-template-columns: 70px minmax(0, 1fr); gap: 12px; padding: 12px 14px; border-bottom: 1px solid var(--line); background: var(--surface); }\n.rung:last-child { border-bottom: 0; }\n.rung .day { font-family: var(--font-mono); font-size: 0.85rem; color: var(--muted); }\n.rung b { display: block; }\n.rung span { color: var(--muted); font-size: 0.9rem; }\ndl.gloss { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 6px 18px; margin: 0; max-width: 72ch; }\ndl.gloss dt { font-weight: 600; }\ndl.gloss dd { margin: 0; color: var(--muted); }\n@media (max-width: 520px) { dl.gloss { grid-template-columns: 1fr; } dl.gloss dd { margin-bottom: 8px; } }\n\n/* checklist */\n.ck { display: grid; gap: 22px; max-width: 72ch; }\n.ck-group { border: 1px solid var(--line); border-radius: 8px; background: var(--surface); padding: 14px 16px; display: grid; gap: 6px; }\n.ck label { display: flex; gap: 10px; align-items: flex-start; padding: 6px 0; cursor: pointer; }\n.ck input { margin-top: 4px; accent-color: var(--accent); }\n.ck label.checked span { color: var(--muted); text-decoration: line-through; }\n.footer { color: var(--muted); font-size: 0.82rem; margin-top: 48px; border-top: 1px solid var(--line); padding-top: 14px; }\n@media (prefers-reduced-motion: no-preference) { .side button.hint { animation: pulse 1.6s ease-in-out infinite; } @keyframes pulse { 50% { box-shadow: inset 0 0 0 2px transparent; } } }\n</style>\n\n<header class=\"topbar\">\n  <div class=\"topbar-in\">\n    <div class=\"brand\">Billing Agent<small>AR specialist onboarding</small></div>\n    <nav class=\"tabs\" id=\"tabs\">\n      <a href=\"#start\">Start</a>\n      <a href=\"#walkthrough\">Walkthrough</a>\n      <a href=\"#handbook\">Handbook</a>\n      <a href=\"#checklist\">Checklist</a>\n    </nav>\n  </div>\n</header>\n\n<main>\n<div class=\"wrap\">\n\n<!-- ================= START ================= -->\n<section class=\"view\" id=\"view-start\">\n  <div class=\"hero\">\n    <div class=\"prose\" style=\"display:grid;gap:18px\">\n      <div>\n        <p class=\"eyebrow\">Welcome to the collections desk</p>\n        <h1 style=\"margin-top:6px\">Learn the billing system before you touch it</h1>\n      </div>\n      <p class=\"lede\">You will be chasing overdue invoices for YOWI and ABBA clients. This course teaches the system in a safe copy: the screens look like the real ones, the clients are made up, and nothing you click sends an email or changes a record. The rest of the app opens once you have finished it.</p>\n      <div class=\"notice\">\n        <b>Training data only.</b> Every company, amount and email address here is invented. In the live app the names will be different and every button will be live.\n      </div>\n      <p>Plan on about an hour: 25 minutes for the walkthrough, the rest reading the handbook. Do the walkthrough first; the handbook will make more sense once you have seen the screens. When both are done, use the <b>Finish onboarding</b> button above this course.</p>\n    </div>\n    <div class=\"paths\">\n      <a class=\"path\" href=\"#walkthrough\"><strong>1 \u00b7 Walkthrough</strong><span>Eight guided tasks in a practice copy of the app: send a reminder, log a promise, record a payment, set an account read-only, record a renewal.</span><br><em>About 25 minutes \u2192</em></a>\n      <a class=\"path\" href=\"#handbook\"><strong>2 \u00b7 Handbook</strong><span>How an invoice moves, the reminder ladder, what you may and may not do, and a glossary of the Philippine tax terms you will see on every bill.</span><br><em>About 30 minutes \u2192</em></a>\n      <a class=\"path\" href=\"#checklist\"><strong>3 \u00b7 First two weeks</strong><span>What to have done by the end of day one, week one and week two. Tick things off as you go; it saves on this device.</span><br><em>Keep open \u2192</em></a>\n    </div>\n  </div>\n</section>\n\n<!-- ================= WALKTHROUGH ================= -->\n<section class=\"view\" id=\"view-walkthrough\" hidden>\n  <div style=\"display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:flex-end;margin-bottom:16px\">\n    <div>\n      <p class=\"eyebrow\">Practice copy</p>\n      <h2>A day on the collections desk</h2>\n    </div>\n    <button class=\"btn\" id=\"reset-sandbox\">Reset the sandbox</button>\n  </div>\n  <div class=\"wt\">\n    <div class=\"app\" id=\"app\">\n      <div class=\"app-head\"><span class=\"dots\"><span></span><span></span><span></span></span> billing-agent \u00b7 Getting paid <span class=\"sandbox-tag\">Training sandbox</span></div>\n      <div class=\"app-body\">\n        <aside class=\"side\"><nav id=\"sidenav\"></nav></aside>\n        <div class=\"pane\" id=\"pane\"></div>\n      </div>\n    </div>\n    <aside class=\"coach\" id=\"coach\"></aside>\n  </div>\n</section>\n\n<!-- ================= HANDBOOK ================= -->\n<section class=\"view\" id=\"view-handbook\" hidden>\n  <div style=\"margin-bottom:24px\">\n    <p class=\"eyebrow\">Handbook</p>\n    <h2>Accounts receivable on the Billing Agent</h2>\n  </div>\n  <div class=\"hb\">\n    <nav class=\"toc\">\n      <a href=\"#handbook\" data-scroll=\"hb-job\">Your job</a>\n      <a href=\"#handbook\" data-scroll=\"hb-lifecycle\">How an invoice moves</a>\n      <a href=\"#handbook\" data-scroll=\"hb-day\">Your daily routine</a>\n      <a href=\"#handbook\" data-scroll=\"hb-ladder\">The reminder ladder</a>\n      <a href=\"#handbook\" data-scroll=\"hb-manual\">Clients chased by hand</a>\n      <a href=\"#handbook\" data-scroll=\"hb-promises\">Promises to pay</a>\n      <a href=\"#handbook\" data-scroll=\"hb-payments\">Recording a payment</a>\n      <a href=\"#handbook\" data-scroll=\"hb-suspension\">Suspension</a>\n      <a href=\"#handbook\" data-scroll=\"hb-renewals\">Renewals</a>\n      <a href=\"#handbook\" data-scroll=\"hb-rules\">Rules that do not bend</a>\n      <a href=\"#handbook\" data-scroll=\"hb-access\">Your access</a>\n      <a href=\"#handbook\" data-scroll=\"hb-gloss\">Glossary</a>\n    </nav>\n    <article class=\"doc\">\n      <section id=\"hb-job\">\n        <h3>Your job in one paragraph</h3>\n        <p>Clients sign a contract for a monthly service (payroll, accounting, compliance or HR). The system turns each contract into an invoice, someone approves it, and it is emailed to the client as a PDF. From that moment the invoice is yours until the money arrives. You make sure every open invoice is either paid, promised with a date, or escalating towards a suspension notice, and that nothing goes quiet.</p>\n        <p>Two legal entities issue invoices: <b>YOWI</b> and <b>ABBA</b>. Each has its own invoice numbers, bank accounts and TIN. A client can have contracts with either, or both. Always check which entity an invoice belongs to before quoting bank details.</p>\n      </section>\n\n      <section id=\"hb-lifecycle\">\n        <h3>How an invoice moves</h3>\n        <div class=\"tbl-wrap\"><table>\n          <thead><tr><th>Status</th><th>Meaning</th><th>Who acts</th></tr></thead>\n          <tbody>\n            <tr><td><span class=\"pill line\">PENDING</span></td><td>Generated, waiting for approval. No email yet.</td><td>Approver</td></tr>\n            <tr><td><span class=\"pill info\">APPROVED</span></td><td>Checked and ready to send.</td><td>Approver clicks Send</td></tr>\n            <tr><td><span class=\"pill warn\">SENT</span></td><td>Emailed to the client with the PDF. The clock starts. <b>This is where you work.</b></td><td>You</td></tr>\n            <tr><td><span class=\"pill warn\">PARTIALLY PAID</span></td><td>Some money arrived; a balance is still due. Still chased.</td><td>You</td></tr>\n            <tr><td><span class=\"pill good\">PAID</span></td><td>Balance is zero. Leaves your lists.</td><td>You, or the online payment webhook</td></tr>\n            <tr><td><span class=\"pill bad\">REJECTED / VOID</span></td><td>Pulled before sending. Not your concern.</td><td>Approver / Admin</td></tr>\n          </tbody>\n        </table></div>\n        <p>Only <b>SENT</b> and <b>PARTIALLY PAID</b> invoices can be chased. If a client says they never received an invoice, check its status first: an invoice that is still APPROVED was never emailed.</p>\n      </section>\n\n      <section id=\"hb-day\">\n        <h3>Your daily routine</h3>\n        <ol>\n          <li><b>Worklist</b> (Getting paid \u2192 Worklist). Open it first. It lists the clients and tasks assigned to you today and carries anything unfinished over from yesterday. Add a task for every call you promise to make.</li>\n          <li><b>Follow-up Queue \u2192 Needs action.</b> Each row tells you why it is there: a broken promise, a client on manual follow-up, an invoice with no email address, or one that needs a human look before the next reminder. Clear this list every morning.</li>\n          <li><b>Promises to Pay.</b> See who promised money for today and this week. A promise that passes its date unpaid comes back to the queue as a broken promise the next morning.</li>\n          <li><b>Record payments.</b> As proof of payment arrives in <span class=\"num\">billingcollection@abba.works</span>, mark the invoice paid, with the amount, the method and which bank account it landed in.</li>\n          <li><b>Suspensions.</b> Check the \"Set to read-only\" tab. Anyone there has passed their grace period without paying.</li>\n          <li>Weekly: <b>Renewals</b> (contracts ending within 45 days) and <b>2307 Certificates</b> (withholding certificates clients still owe us).</li>\n        </ol>\n        <div class=\"callout tip\">The Follow-up Queue also shows <b>What tonight would send</b>: the reminders the system will email by itself after midnight. Read it every afternoon. If a client has just paid or just called, you have until then to stop their reminder.</div>\n      </section>\n\n      <section id=\"hb-ladder\">\n        <h3>The reminder ladder</h3>\n        <p>Every chaseable invoice climbs the same four levels, counted in days after its due date. Each level has its own email template, set by the admin. The next reminder is always the next level up; the system never repeats a level or goes backwards.</p>\n        <div class=\"ladder\">\n          <div class=\"rung\"><span class=\"day\">Day 1</span><div><b>Level 1 \u00b7 Gentle reminder</b><span>A courteous nudge. Most clients pay after this one.</span></div></div>\n          <div class=\"rung\"><span class=\"day\">Day 7</span><div><b>Level 2 \u00b7 Firm reminder</b><span>States the overdue amount and days overdue.</span></div></div>\n          <div class=\"rung\"><span class=\"day\">Day 15</span><div><b>Level 3 \u00b7 Final notice</b><span>Last reminder before consequences are named.</span></div></div>\n          <div class=\"rung\"><span class=\"day\">Day 30</span><div><b>Level 4 \u00b7 Suspension notice</b><span>Tells the client their account will be set to read-only if payment is not received within the grace period (7 days). Starts that clock. Needs a stronger confirmation, and in your first month, your lead's go-ahead.</span></div></div>\n        </div>\n        <p>Two ways a reminder goes out:</p>\n        <ul>\n          <li><b>By hand</b>, from the Follow-up Queue, by clicking <b>Send L2</b> (or whichever level is next). You will do most of your sending this way.</li>\n          <li><b>Automatically</b>, by the nightly sweep, but only for the levels the admin has armed and only up to a nightly cap (25 emails). Right now levels 1 and 2 are armed. Levels 3 and 4 are never sent without a person.</li>\n        </ul>\n        <p>The suspension notice does not have to wait for levels 2 and 3. For a client who has gone silent or broken promises, the queue offers <b>Suspension notice</b> directly. The skip is written to the audit log with your name on it.</p>\n      </section>\n\n      <section id=\"hb-manual\">\n        <h3>Clients chased by hand</h3>\n        <p>Some clients must never receive an automatic reminder. Each contract has an \"Include in automated follow-ups\" switch, and each partner has one too. When it is off, the client still appears in your queue, tagged <span class=\"pill info\">Manual follow-up</span>, but the nightly sweep ignores them. You decide when, and whether, to send.</p>\n        <ul>\n          <li><b>RCBC</b>: one consolidated bill a month covering dozens of end-clients, paid through the bank's own process. Never send it a reminder without your lead.</li>\n          <li><b>Globe Telecom</b> clients: billed through Globe's arrangement; follow-through runs on a different timing. Treat the queue tag as \"ask first\".</li>\n          <li>Any contract an admin has switched off, usually because the client has a special payment arrangement.</li>\n        </ul>\n      </section>\n\n      <section id=\"hb-promises\">\n        <h3>Promises to pay</h3>\n        <p>When a client tells you when they will pay, log it. A logged promise pauses the ladder for that invoice until the promised date, so the client is not reminded about money they have already committed to. If the date passes unpaid, the invoice returns to Needs action as a <span class=\"pill bad\">Broken promise</span>, and the next reminder is due immediately.</p>\n        <p>Log the date, the amount if it is less than the full balance, how they told you (call, email, chat) and who you spoke to. Vague promises (\"next week\") get the last working day of that week.</p>\n      </section>\n\n      <section id=\"hb-payments\">\n        <h3>Recording a payment</h3>\n        <ol>\n          <li>Open the invoice and choose <b>Record payment</b>.</li>\n          <li>Enter the <b>amount actually received</b>, not the invoice total. A short payment makes the invoice PARTIALLY PAID, with the balance still chased.</li>\n          <li>Choose the method: Bank transfer, Cheque, Cash or HitPay. For transfers and cheques, pick <b>which bank account</b> the money landed in. The cash management team relies on this.</li>\n          <li>Put the bank reference or cheque number in the reference field, and the date it cleared.</li>\n          <li>If the client deducted withholding tax, the invoice is settled by their payment plus their <b>2307 certificate</b>. Record the payment, then track the certificate on the 2307 page until it arrives.</li>\n        </ol>\n        <div class=\"callout rule\">Never mark an invoice paid from a client's word alone. You need the proof of payment in the collections inbox or the amount visible on the bank statement.</div>\n      </section>\n\n      <section id=\"hb-suspension\">\n        <h3>Suspension</h3>\n        <p>Sending the Level 4 notice starts a 7-day grace period. The <b>Suspensions</b> page tracks every client from that moment:</p>\n        <ul>\n          <li><b>Grace running</b>: notice sent, deadline not yet reached. Keep chasing by phone.</li>\n          <li><b>Set to read-only</b>: deadline passed, still unpaid. The system does not do the suspension itself. Someone switches the client's payroll or accounting account to read-only by hand, then marks it here so the list stays true.</li>\n          <li><b>Currently read-only</b>: suspended clients. Their data stays viewable; processing is stopped.</li>\n          <li><b>Restore access</b>: a suspended client has now paid. Restoring access is the most urgent item on the page. Do it the same day.</li>\n        </ul>\n        <p>In your first month you do not set accounts to read-only yourself. You flag the row to your lead, who does it and marks it.</p>\n      </section>\n\n      <section id=\"hb-renewals\">\n        <h3>Renewals</h3>\n        <p>Every contract has a renewal date. The Renewals page shows which ones are inside the 45-day window (<b>Needs action</b>), which have already passed (<b>Lapsed</b>), and which are coming up. The system never emails the client about a renewal. The conversation is yours: confirm whether they are continuing, at what fee, and record the outcome as <b>Renewed</b> (with the new date) or <b>Not renewing</b>.</p>\n        <p>Recording \"Not renewing\" does not stop billing. Stopping the contract is a separate step your lead takes.</p>\n      </section>\n\n      <section id=\"hb-rules\">\n        <h3>Rules that do not bend</h3>\n        <div class=\"callout rule\">\n          <ul>\n            <li>Quote only the bank accounts printed on the invoice for that entity. Never a personal account, never an account from the other entity.</li>\n            <li>No Level 4 suspension notice and no read-only switch without your lead's go-ahead during your first month.</li>\n            <li>Never change a contract's fee, status or renewal date to settle an argument. Raise it; an admin changes it with a note.</li>\n            <li>Never mark paid without proof. Never delete anything.</li>\n            <li>Partner clients (RCBC, Globe) and anyone tagged Manual follow-up: ask before sending.</li>\n            <li>Everything you do is written to the audit log with your name. That protects you as much as the company.</li>\n          </ul>\n        </div>\n      </section>\n\n      <section id=\"hb-access\">\n        <h3>Your access</h3>\n        <p>You start as a <b>Viewer</b>: you can see every list, open every PDF and read the queue, but the Send, Record payment and Log promise buttons are off. During week one you shadow your lead through those actions. Once you have done each one correctly under supervision, your account is moved to <b>Approver</b>, which turns the buttons on. Admin (settings, users, templates, contract edits) stays with the finance lead.</p>\n        <p>Your sign-in is personal. Do not share it; do not use anyone else's.</p>\n      </section>\n\n      <section id=\"hb-gloss\">\n        <h3>Glossary</h3>\n        <dl class=\"gloss\">\n          <dt>Billing entity</dt><dd>The company issuing the invoice: YOWI or ABBA. Decides the bank account, TIN and invoice number series.</dd>\n          <dt>Partner</dt><dd>An intermediary an invoice is addressed through (Globe Telecom, RCBC, Sterling Bank of Asia). \"Direct Billing\" means no intermediary.</dd>\n          <dt>Customer number</dt><dd>The contract's code, e.g. ABBA-0142 or YOWI-0019. One client can have several, one per product.</dd>\n          <dt>Billing No.</dt><dd>The invoice number, e.g. BILL NO.0000000754. Quote it in every email and call.</dd>\n          <dt>VAT</dt><dd>12% value-added tax added on top of the service fee for VAT-registered clients.</dd>\n          <dt>EWT / withholding</dt><dd>Expanded withholding tax (usually 2%) the client deducts and remits to the BIR on our behalf. The invoice's net amount already allows for it.</dd>\n          <dt>BIR Form 2307</dt><dd>The certificate the client gives us proving they remitted that withholding. Without it we cannot claim the credit, so it is chased like money.</dd>\n          <dt>SOA</dt><dd>Statement of account: the PDF layout with the entity's bank details and signatories.</dd>\n          <dt>PDC</dt><dd>Post-dated cheque. Logged with its date; counts as a promise until it clears.</dd>\n          <dt>HitPay</dt><dd>The online payment link on some invoices. When used, the invoice marks itself paid.</dd>\n          <dt>Grace period</dt><dd>The 7 days between the suspension notice and the read-only deadline.</dd>\n          <dt>Read-only</dt><dd>The suspended state: the client can view their records but cannot run payroll, update timekeeping or generate reports.</dd>\n        </dl>\n      </section>\n    </article>\n  </div>\n</section>\n\n<!-- ================= CHECKLIST ================= -->\n<section class=\"view\" id=\"view-checklist\" hidden>\n  <div style=\"margin-bottom:20px\">\n    <p class=\"eyebrow\">First two weeks</p>\n    <h2>What done looks like</h2>\n    <p class=\"note\" style=\"margin-top:6px\">Ticks are saved on this device only. Your lead keeps the official copy.</p>\n  </div>\n  <div class=\"ck\" id=\"checklist\"></div>\n</section>\n\n<p class=\"footer wrap\">Training material for the YOWI / ABBA Billing Agent. All client names, amounts and addresses on this page are fictional.</p>\n</div>\n</main>\n\n<script>\n(function () {\n  'use strict';\n  var peso = function (n) { return '\u20b1' + Number(n).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); };\n  var store = {\n    get: function (k, d) { try { var v = localStorage.getItem(k); return v === null ? d : JSON.parse(v); } catch (e) { return d; } },\n    set: function (k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} }\n  };\n\n  /* ---------- routing ---------- */\n  var VIEWS = ['start', 'walkthrough', 'handbook', 'checklist'];\n  function route() {\n    var h = (location.hash || '#start').slice(1);\n    if (VIEWS.indexOf(h) < 0) h = 'start';\n    VIEWS.forEach(function (v) { document.getElementById('view-' + v).hidden = v !== h; });\n    document.querySelectorAll('#tabs a').forEach(function (a) {\n      if (a.getAttribute('href') === '#' + h) a.setAttribute('aria-current', 'page'); else a.removeAttribute('aria-current');\n    });\n    if (h === 'walkthrough') render();\n  }\n  window.addEventListener('hashchange', route);\n  document.querySelectorAll('.toc a').forEach(function (a) {\n    a.addEventListener('click', function (e) {\n      e.preventDefault();\n      if (location.hash !== '#handbook') location.hash = 'handbook';\n      route();\n      var el = document.getElementById(a.getAttribute('data-scroll'));\n      if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });\n    });\n  });\n\n  /* ---------- sandbox data (all fictional) ---------- */\n  function fresh() {\n    return {\n      screen: 'worklist',\n      visited: {},\n      step: 0,\n      done: {},\n      toast: '',\n      sheet: null,\n      subtab: {},\n      worklist: [\n        { id: 'w1', title: 'Tanglaw Agri Ventures', sub: 'Level 1 sent 8 days ago, no reply', amount: 18500, done: false },\n        { id: 'w2', title: 'Call Silangan Builders about the \u20b124,000 balance', sub: 'Task \u00b7 they asked for a call-back', amount: null, done: false },\n        { id: 'w3', title: 'Kabisig Logistics', sub: 'Proof of payment in the inbox this morning', amount: 12600, done: false },\n        { id: 'w4', title: 'Dalisay Pharma Distributors', sub: 'Suspension notice sent, grace period over', amount: 31200, done: false }\n      ],\n      invoices: [\n        { id: 'i1', no: 'BILL NO.0000000812', client: 'Tanglaw Agri Ventures', cust: 'TRN-0001', entity: 'ABBA', partner: 'Direct Billing (ABBA)', product: 'Payroll', amount: 18500, balance: 18500, status: 'SENT', overdue: 9, level: 1, auto: true, email: 'accounting@tanglaw-agri.example', cat: 'REVIEW', note: 'Level 2 is due; level 1 went out 8 days ago.' },\n        { id: 'i2', no: 'BILL NO.0000000798', client: 'Silangan Builders Corp.', cust: 'TRN-0004', entity: 'ABBA', partner: 'Direct Billing (ABBA)', product: 'Accounting', amount: 24000, balance: 24000, status: 'SENT', overdue: 3, level: 1, auto: true, email: 'finance@silangan-builders.example', cat: 'REVIEW', note: 'Asked for a call-back before any further reminder.' },\n        { id: 'i3', no: 'BILL NO.0000000805', client: 'Kabisig Logistics Inc.', cust: 'TRN-0007', entity: 'ABBA', partner: 'Direct Billing (ABBA)', product: 'Payroll', amount: 12600, balance: 12600, status: 'SENT', overdue: 12, level: 2, auto: true, email: 'ap@kabisig-logistics.example', cat: null, note: '' },\n        { id: 'i4', no: 'BILL NO.0000000771', client: 'Dalisay Pharma Distributors', cust: 'TRN-0010', entity: 'ABBA', partner: 'Direct Billing (ABBA)', product: 'Accounting', amount: 31200, balance: 31200, status: 'SENT', overdue: 41, level: 4, auto: true, email: 'owner@dalisay-pharma.example', cat: null, note: '', noticeDaysAgo: 9, suspended: false },\n        { id: 'i5', no: 'BILL NO.0000000790', client: 'Bayanihan Dental Clinic', cust: 'TRN-0012', entity: 'YOWI', partner: 'Direct Billing (YOWI)', product: 'Payroll', amount: 7000, balance: 7000, status: 'SENT', overdue: 16, level: 2, auto: true, email: 'drreyes@bayanihan-dental.example', cat: 'BROKEN_PROMISE', note: 'Promised 10 Nov by Dr Reyes \u2014 not paid.' },\n        { id: 'i6', no: 'BILL NO.0000000783', client: 'Mabuhay Resort Palawan', cust: 'TRN-0015', entity: 'YOWI', partner: 'Globe Telecom', product: 'Payroll', amount: 9553.58, balance: 9553.58, status: 'SENT', overdue: 20, level: 0, auto: false, email: 'billing@mabuhay-palawan.example', cat: 'MANUAL', note: 'Globe partner client \u2014 ask before sending.' },\n        { id: 'i7', no: 'BILL NO.0000000809', client: 'Luntian Foods Corp.', cust: 'TRN-0018', entity: 'ABBA', partner: 'Direct Billing (ABBA)', product: 'Compliance', amount: 18000, balance: 0, status: 'PAID', overdue: 0, level: 0, auto: true, email: '', cat: null, note: '', wht: 360, whtStatus: 'PENDING' },\n        { id: 'i8', no: 'BILL NO.0000000801', client: 'Harana Events Management', cust: 'TRN-0021', entity: 'YOWI', partner: 'Direct Billing (YOWI)', product: 'HR', amount: 5600, balance: 5600, status: 'SENT', overdue: 6, level: 1, auto: true, email: '', cat: 'NO_EMAIL', note: 'No email address on file \u2014 call them for one.' }\n      ],\n      promises: [\n        { id: 'p1', client: 'Bayanihan Dental Clinic', no: 'BILL NO.0000000790', date: '2026-11-10', amount: 7000, by: 'Dr Reyes', channel: 'Call', kept: false, broken: true }\n      ],\n      renewals: [\n        { id: 'r1', client: 'Tanglaw Agri Ventures', product: 'Payroll', entity: 'ABBA', partner: 'Direct Billing (ABBA)', fee: 18500, ends: '2026-12-07', days: 20, outcome: null },\n        { id: 'r2', client: 'Harana Events Management', product: 'HR', entity: 'YOWI', partner: 'Direct Billing (YOWI)', fee: 5600, ends: '2026-11-02', days: -15, outcome: null },\n        { id: 'r3', client: 'Kabisig Logistics Inc.', product: 'Payroll', entity: 'ABBA', partner: 'Direct Billing (ABBA)', fee: 12600, ends: '2027-01-30', days: 74, outcome: null }\n      ],\n      payments: []\n    };\n  }\n  var S = store.get('ar-sandbox-v1', null) || fresh();\n  function save() { store.set('ar-sandbox-v1', S); }\n\n  var NAV = [\n    { grp: 'Getting paid' },\n    { id: 'worklist', label: 'Worklist' },\n    { id: 'queue', label: 'Follow-up Queue' },\n    { id: 'promises', label: 'Promises to Pay' },\n    { id: 'wht', label: '2307 Certificates' },\n    { id: 'suspensions', label: 'Suspensions' },\n    { grp: 'Invoices' },\n    { id: 'invoices', label: 'All Invoices' },\n    { grp: 'Clients' },\n    { id: 'renewals', label: 'Renewals' }\n  ];\n\n  /* ---------- steps ---------- */\n  var STEPS = [\n    { id: 'tour', screen: null, title: 'Find your way around', why: 'The pages you will live in are under Getting paid. Nothing here is real; click anything.', task: 'Open <b>three different pages</b> from the left-hand menu.', check: function () { return Object.keys(S.visited).length >= 3; }, learn: ['Worklist, Follow-up Queue, Promises, 2307, Suspensions: your morning, in that order.', 'All Invoices is where you open a single bill and record a payment.'] },\n    { id: 'worklist', screen: 'worklist', title: 'Start from the Worklist', why: 'It is the shared to-do list. Items stay on it every day until someone marks them done.', task: 'Mark the task <b>\u201cCall Silangan Builders\u201d</b> as done. (You made the call; they will pay on the 28th.)', check: function () { return S.worklist.filter(function (w) { return w.id === 'w2'; })[0].done; }, learn: ['A client on the list means \u201clook at everything open for them\u201d; a task is one action.', 'Add a task for every call-back you promise, or it will not happen.'] },\n    { id: 'send', screen: 'queue', title: 'Send the next reminder', why: 'Tanglaw had the gentle reminder eight days ago and has not replied. The next rung is the firm reminder, level 2.', task: 'In the Follow-up Queue, click <b>Send L2</b> on Tanglaw Agri Ventures and confirm.', check: function () { return inv('i1').level >= 2; }, learn: ['The button always names the level it will send. It is never a repeat.', 'Notice the Globe client is tagged Manual follow-up: the nightly sweep skips them, and so should you unless told otherwise.'] },\n    { id: 'promise', screen: 'promises', title: 'Log a promise to pay', why: 'Silangan Builders said on the phone they will pay the full \u20b124,000 on 28 November. Logging it pauses their reminders until then.', task: 'On Promises to Pay, click <b>Log a promise</b> for Silangan Builders. Date <b>2026-11-28</b>, full amount, channel Call.', check: function () { return S.promises.some(function (p) { return p.client === 'Silangan Builders Corp.'; }); }, learn: ['Bayanihan Dental is a broken promise: the date passed unpaid, so it is back in Needs action.', 'Always record who promised. \u201cThe accountant\u201d is not a name.'] },\n    { id: 'payment', screen: 'invoices', title: 'Record a part-payment', why: 'Kabisig sent proof of a \u20b16,600 transfer to the ABBA BDO account against a \u20b112,600 bill.', task: 'In All Invoices, open <b>Record payment</b> on Kabisig Logistics. Amount <b>6600</b>, Bank transfer, received in <b>ABBA \u00b7 BDO 0012-3456-78</b>.', check: function () { return inv('i3').status === 'PARTIALLY_PAID' || inv('i3').status === 'PAID'; }, learn: ['A short payment makes the invoice Partially paid; the \u20b16,000 balance keeps climbing the ladder.', 'The bank account you pick is how the cash team knows where the money is. Do not guess it.'] },\n    { id: 'suspend', screen: 'suspensions', title: 'Set an account to read-only', why: 'Dalisay Pharma got the suspension notice nine days ago; the grace period was seven. They have not paid or called.', task: 'On Suspensions, open <b>Set to read-only</b> and mark Dalisay Pharma as suspended. (In real life your lead does this in your first month.)', check: function () { return inv('i4').suspended; }, learn: ['The system never suspends an account itself. A person switches it, then records it here.', 'The moment a suspended client pays, Restore access becomes the most urgent row on the page.'] },\n    { id: 'wht', screen: 'wht', title: 'Chase a 2307 certificate', why: 'Luntian Foods paid, but deducted \u20b1360 withholding tax. We need their BIR 2307 to claim it.', task: 'On 2307 Certificates, click <b>Request certificate</b> for Luntian Foods.', check: function () { return inv('i7').whtStatus === 'REQUESTED'; }, learn: ['A 2307 is money: without it the \u20b1360 is simply lost.', 'Request, then follow up weekly until it is marked received.'] },\n    { id: 'renew', screen: 'renewals', title: 'Record a renewal', why: 'Tanglaw\u2019s payroll contract ends in 20 days. You called; they are continuing at the same fee for another year.', task: 'On Renewals, click <b>Renewed</b> on Tanglaw Agri Ventures and keep the suggested new date.', check: function () { return S.renewals[0].outcome === 'RENEWED'; }, learn: ['The system reminds you 45 days ahead; it never emails the client. The conversation is yours.', 'Harana is Lapsed: its date passed with nothing recorded. That is the state to avoid.'] }\n  ];\n  function inv(id) { return S.invoices.filter(function (i) { return i.id === id; })[0]; }\n  function currentStep() { return STEPS[S.step]; }\n  function advanceIfDone() {\n    var st = currentStep();\n    if (st && st.check() && !S.done[st.id]) { S.done[st.id] = true; S.toast = S.toast || '\u2713 Step complete: ' + st.title; }\n  }\n\n  /* ---------- render ---------- */\n  var sidenav = document.getElementById('sidenav'), pane = document.getElementById('pane'), coach = document.getElementById('coach');\n  function esc(s) { return String(s).replace(/[&<>\"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c]; }); }\n\n  function render() {\n    advanceIfDone();\n    var st = currentStep();\n    var hintScreen = st && !S.done[st.id] ? st.screen : null;\n    sidenav.innerHTML = NAV.map(function (n) {\n      if (n.grp) return '<div class=\"grp\">' + n.grp + '</div>';\n      return '<button data-screen=\"' + n.id + '\"' + (S.screen === n.id ? ' aria-current=\"page\"' : '') + (hintScreen === n.id && S.screen !== n.id ? ' class=\"hint\"' : '') + '>' + n.label + '</button>';\n    }).join('');\n    pane.innerHTML = (S.toast ? '<div class=\"toast\">' + esc(S.toast) + '</div>' : '') + SCREENS[S.screen]();\n    renderCoach();\n    save();\n  }\n\n  function pill(cat) {\n    return { REVIEW: '<span class=\"pill warn\">Needs review</span>', BROKEN_PROMISE: '<span class=\"pill bad\">Broken promise</span>', MANUAL: '<span class=\"pill info\">Manual follow-up</span>', NO_EMAIL: '<span class=\"pill line\">No email</span>' }[cat] || '';\n  }\n  function statusPill(s) {\n    return { SENT: '<span class=\"pill warn\">Sent</span>', PARTIALLY_PAID: '<span class=\"pill warn\">Partially paid</span>', PAID: '<span class=\"pill good\">Paid</span>' }[s] || s;\n  }\n  function clientCell(i) { return '<td class=\"client\"><b>' + esc(i.client) + '</b><small>' + esc(i.no) + ' \u00b7 ' + esc(i.product) + '</small></td>'; }\n\n  var SCREENS = {\n    worklist: function () {\n      var open = S.worklist.filter(function (w) { return !w.done; }), done = S.worklist.filter(function (w) { return w.done; });\n      var row = function (w) {\n        return '<tr><td class=\"client\"><b>' + esc(w.title) + '</b><small>' + esc(w.sub) + '</small></td><td class=\"r num\">' + (w.amount ? peso(w.amount) : '\u2014') + '</td><td><span class=\"pill line\">Mine</span></td><td class=\"actions\">' + (w.done ? '<span class=\"pill good\">Done</span>' : '<button class=\"btn\" data-act=\"wl-done\" data-id=\"' + w.id + '\">Mark done</button>') + '</td></tr>';\n      };\n      return '<div class=\"pane-title\"><h3>Worklist</h3><span class=\"note\">Mon 17 Nov 2026</span></div><p class=\"pane-sub\">Clients and tasks to work on today, and what got done</p>' +\n        '<div class=\"subtabs\"><button aria-pressed=\"true\">Mine</button><button>Everyone</button></div>' +\n        '<div class=\"tbl-wrap\"><table><thead><tr><th>Item</th><th class=\"r\">Open balance</th><th>Owner</th><th></th></tr></thead><tbody>' + open.map(row).join('') + done.map(row).join('') + '</tbody></table></div>' +\n        '<p class=\"note\" style=\"margin-top:10px\">Anything not marked done is on tomorrow\u2019s list too.</p>';\n    },\n    queue: function () {\n      var needs = S.invoices.filter(function (i) { return i.cat && (i.status === 'SENT' || i.status === 'PARTIALLY_PAID'); });\n      var tonight = S.invoices.filter(function (i) { return i.auto && i.status !== 'PAID' && !i.cat && i.level < 2 && i.overdue >= 7; });\n      var sheet = '';\n      if (S.sheet && S.sheet.kind === 'send') {\n        var t = inv(S.sheet.id), lvl = t.level + 1, isL4 = S.sheet.level === 4;\n        var sendLvl = isL4 ? 4 : lvl;\n        sheet = '<div class=\"sheet' + (isL4 ? ' danger' : '') + '\"><h4>' + (isL4 ? 'Send the SUSPENSION NOTICE' : 'Send the level-' + sendLvl + ' reminder') + ' for ' + esc(t.no) + ' to ' + esc(t.client) + '?</h4>' +\n          '<p class=\"note\">To: ' + esc(t.email) + ' \u00b7 ' + peso(t.balance) + ' \u00b7 ' + t.overdue + ' days overdue' + (isL4 ? '<br>This tells them their account will be set to read-only if they do not pay within 7 days, and starts that clock.' + (lvl < 4 ? ' It skips level ' + lvl + (lvl < 3 ? ' and ' + (lvl + 1) : '') + '.' : '') : '') + '</p>' +\n          '<div class=\"actions\"><button class=\"btn primary\" data-act=\"send-confirm\" data-id=\"' + t.id + '\" data-level=\"' + sendLvl + '\">Yes, send</button><button class=\"btn\" data-act=\"sheet-close\">Cancel</button></div></div>';\n      }\n      var rows = needs.map(function (i) {\n        var next = i.level + 1;\n        var canSend = i.email && i.level < 4;\n        var btns = '';\n        if (canSend) btns += '<button class=\"btn\" data-act=\"send\" data-id=\"' + i.id + '\" data-level=\"' + next + '\">' + (next === 4 ? 'Send suspension notice' : 'Send L' + next) + '</button>';\n        if (canSend && next < 4) btns += '<button class=\"btn ghost danger\" data-act=\"send\" data-id=\"' + i.id + '\" data-level=\"4\" title=\"Skip the remaining reminders\">Suspension notice</button>';\n        btns += '<button class=\"btn\" data-act=\"promise-open\" data-id=\"' + i.id + '\">Log promise</button>';\n        return '<tr>' + clientCell(i) + '<td><span class=\"pill line\">' + i.entity + '</span></td><td class=\"r num\">' + i.overdue + 'd</td><td class=\"r num\">' + peso(i.balance) + '</td><td>' + pill(i.cat) + '<div class=\"note\" style=\"max-width:220px\">' + esc(i.note) + '</div></td><td class=\"actions\">' + btns + '</td></tr>';\n      }).join('');\n      return '<div class=\"pane-title\"><h3>Follow-up Queue</h3></div><p class=\"pane-sub\">Today\u2019s ladder actions: what needs you, and what runs itself</p>' + sheet +\n        '<h4 style=\"margin:4px 0 8px\">Needs action <span class=\"note\">(' + needs.length + ')</span></h4>' +\n        '<div class=\"tbl-wrap\"><table><thead><tr><th>Client / invoice</th><th>Entity</th><th class=\"r\">Overdue</th><th class=\"r\">Balance</th><th>Why it\u2019s here</th><th></th></tr></thead><tbody>' + (rows || '<tr><td colspan=\"6\" class=\"empty\">Nothing needs you right now.</td></tr>') + '</tbody></table></div>' +\n        '<h4 style=\"margin:18px 0 8px\">What tonight would send <span class=\"note\">(armed: levels 1, 2 \u00b7 cap 25)</span></h4>' +\n        '<div class=\"tbl-wrap\"><table><thead><tr><th>Client / invoice</th><th class=\"r\">Overdue</th><th>Level</th></tr></thead><tbody>' + (tonight.map(function (i) { return '<tr>' + clientCell(i) + '<td class=\"r num\">' + i.overdue + 'd</td><td><span class=\"pill line\">L' + (i.level + 1) + '</span></td></tr>'; }).join('') || '<tr><td colspan=\"3\" class=\"empty\">Nothing is scheduled for tonight.</td></tr>') + '</tbody></table></div>';\n    },\n    promises: function () {\n      var sheet = '';\n      if (S.sheet && S.sheet.kind === 'promise') {\n        var t = inv(S.sheet.id);\n        sheet = '<div class=\"sheet\"><h4>Log a promise \u00b7 ' + esc(t.client) + ' \u00b7 ' + esc(t.no) + '</h4>' +\n          '<div class=\"fields\"><label class=\"field\">Promised date<input type=\"date\" id=\"pr-date\" value=\"2026-11-28\"></label><label class=\"field\">Amount<input type=\"number\" id=\"pr-amount\" value=\"' + t.balance + '\" step=\"0.01\"></label><label class=\"field\">Channel<select id=\"pr-channel\"><option>Call</option><option>Email</option><option>Chat</option><option>In person</option></select></label><label class=\"field\">Who promised<input type=\"text\" id=\"pr-by\" placeholder=\"Name and role\" value=\"Mr Dizon, accountant\"></label></div>' +\n          '<div class=\"actions\"><button class=\"btn primary\" data-act=\"promise-save\" data-id=\"' + t.id + '\">Save promise</button><button class=\"btn\" data-act=\"sheet-close\">Cancel</button></div></div>';\n      }\n      var candidates = S.invoices.filter(function (i) { return (i.status === 'SENT' || i.status === 'PARTIALLY_PAID') && !S.promises.some(function (p) { return p.no === i.no && !p.broken; }); });\n      return '<div class=\"pane-title\"><h3>Promises to Pay</h3></div><p class=\"pane-sub\">What clients committed to, and whether they kept it</p>' + sheet +\n        '<div class=\"stats\"><div class=\"stat\"><b class=\"num\">' + S.promises.filter(function (p) { return !p.broken && !p.kept; }).length + '</b><span>open promises</span></div><div class=\"stat\"><b class=\"num\">' + S.promises.filter(function (p) { return p.broken; }).length + '</b><span>broken</span></div><div class=\"stat\"><b class=\"num\">' + peso(S.promises.filter(function (p) { return !p.broken && !p.kept; }).reduce(function (s, p) { return s + p.amount; }, 0)) + '</b><span>promised this month</span></div></div>' +\n        '<div class=\"tbl-wrap\"><table><thead><tr><th>Client / invoice</th><th>Promised</th><th class=\"r\">Amount</th><th>By</th><th>Status</th></tr></thead><tbody>' +\n        S.promises.map(function (p) { return '<tr><td class=\"client\"><b>' + esc(p.client) + '</b><small>' + esc(p.no) + '</small></td><td class=\"num\">' + p.date + '</td><td class=\"r num\">' + peso(p.amount) + '</td><td>' + esc(p.by) + ' \u00b7 ' + esc(p.channel) + '</td><td>' + (p.broken ? '<span class=\"pill bad\">Broken</span>' : p.kept ? '<span class=\"pill good\">Kept</span>' : '<span class=\"pill warn\">Open</span>') + '</td></tr>'; }).join('') +\n        '</tbody></table></div>' +\n        '<h4 style=\"margin:18px 0 8px\">Log a promise</h4><div class=\"tbl-wrap\"><table><tbody>' + candidates.map(function (i) { return '<tr>' + clientCell(i) + '<td class=\"r num\">' + peso(i.balance) + '</td><td class=\"actions\"><button class=\"btn\" data-act=\"promise-open\" data-id=\"' + i.id + '\">Log a promise</button></td></tr>'; }).join('') + '</tbody></table></div>';\n    },\n    invoices: function () {\n      var sheet = '';\n      if (S.sheet && S.sheet.kind === 'pay') {\n        var t = inv(S.sheet.id);\n        sheet = '<div class=\"sheet\"><h4>Record payment \u00b7 ' + esc(t.client) + ' \u00b7 ' + esc(t.no) + '</h4><p class=\"note\">Balance due ' + peso(t.balance) + ' \u00b7 ' + t.entity + ' invoice</p>' +\n          '<div class=\"fields\"><label class=\"field\">Amount received<input type=\"number\" id=\"pay-amount\" step=\"0.01\" placeholder=\"0.00\"></label><label class=\"field\">Method<select id=\"pay-method\"><option>Bank transfer</option><option>Cheque</option><option>Cash</option><option>HitPay</option></select></label><label class=\"field\">Received in<select id=\"pay-bank\"><option value=\"\">Choose the account\u2026</option><option>ABBA \u00b7 BDO 0012-3456-78</option><option>ABBA \u00b7 RCBC 7-654-32109-8</option><option>YOWI \u00b7 BPI 3344-5566-77</option></select></label><label class=\"field\">Reference<input type=\"text\" id=\"pay-ref\" placeholder=\"Bank ref / cheque no.\" value=\"BDO-TRF-20261117-0931\"></label><label class=\"field\">Date paid<input type=\"date\" id=\"pay-date\" value=\"2026-11-17\"></label></div>' +\n          '<p class=\"note\" id=\"pay-err\" style=\"color:var(--bad)\"></p>' +\n          '<div class=\"actions\"><button class=\"btn primary\" data-act=\"pay-save\" data-id=\"' + t.id + '\">Record payment</button><button class=\"btn\" data-act=\"sheet-close\">Cancel</button></div></div>';\n      }\n      return '<div class=\"pane-title\"><h3>All Invoices</h3></div><p class=\"pane-sub\">Every bill, with its balance and what happened to it</p>' + sheet +\n        '<div class=\"tbl-wrap\"><table><thead><tr><th>Client / invoice</th><th>Entity</th><th class=\"r\">Amount</th><th class=\"r\">Balance</th><th>Status</th><th></th></tr></thead><tbody>' +\n        S.invoices.map(function (i) { return '<tr>' + clientCell(i) + '<td><span class=\"pill line\">' + i.entity + '</span></td><td class=\"r num\">' + peso(i.amount) + '</td><td class=\"r num\">' + peso(i.balance) + '</td><td>' + statusPill(i.status) + (i.level ? '<div class=\"note\">L' + i.level + ' sent</div>' : '') + '</td><td class=\"actions\">' + (i.status !== 'PAID' ? '<button class=\"btn\" data-act=\"pay-open\" data-id=\"' + i.id + '\">Record payment</button>' : '') + '<button class=\"btn ghost\" disabled title=\"Opens the PDF in the real app\">PDF</button></td></tr>'; }).join('') +\n        '</tbody></table></div>';\n    },\n    suspensions: function () {\n      var tab = S.subtab.susp || 'due';\n      var d = inv('i4');\n      var stage = d.status === 'PAID' ? (d.suspended ? 'restore' : null) : d.suspended ? 'suspended' : d.noticeDaysAgo >= 7 ? 'due' : 'grace';\n      var tabs = [['due', 'Set to read-only'], ['restore', 'Restore access'], ['grace', 'Grace running'], ['suspended', 'Currently read-only']];\n      var sheet = '';\n      if (S.sheet && S.sheet.kind === 'suspend') {\n        sheet = '<div class=\"sheet danger\"><h4>Mark Dalisay Pharma Distributors as set to read-only?</h4><p class=\"note\">Only do this after the account has actually been switched. This records it so the list stays true, and writes an audit entry with your name.</p><div class=\"actions\"><button class=\"btn primary\" data-act=\"suspend-confirm\">Yes, it is read-only now</button><button class=\"btn\" data-act=\"sheet-close\">Cancel</button></div></div>';\n      }\n      var row = stage === tab ? '<tr>' + clientCell(d) + '<td class=\"r num\">' + peso(d.balance) + '</td><td class=\"num\">' + (stage === 'due' ? 'deadline passed ' + (d.noticeDaysAgo - 7) + 'd ago' : stage === 'grace' ? (7 - d.noticeDaysAgo) + 'd left' : stage === 'suspended' ? 'read-only since today' : 'paid \u2014 restore today') + '</td><td class=\"actions\">' + (stage === 'due' ? '<button class=\"btn danger\" data-act=\"suspend-open\">Set to read-only</button>' : stage === 'restore' ? '<button class=\"btn primary\" data-act=\"restore\">Access restored</button>' : '<span class=\"pill line\">tracking</span>') + '</td></tr>' : '';\n      return '<div class=\"pane-title\"><h3>Suspensions</h3></div><p class=\"pane-sub\">Who has had the suspension notice, and what the grace period says</p>' + sheet +\n        '<div class=\"subtabs\">' + tabs.map(function (t) { return '<button data-act=\"susp-tab\" data-tab=\"' + t[0] + '\" aria-pressed=\"' + (tab === t[0]) + '\">' + t[1] + (stage === t[0] ? ' \u00b7 1' : '') + '</button>'; }).join('') + '</div>' +\n        '<div class=\"tbl-wrap\"><table><thead><tr><th>Client / invoice</th><th class=\"r\">Balance</th><th>Grace</th><th></th></tr></thead><tbody>' + (row || '<tr><td colspan=\"4\" class=\"empty\">Nobody in this group.</td></tr>') + '</tbody></table></div>' +\n        '<p class=\"note\" style=\"margin-top:10px\">Grace period: 7 days from the notice. The system never switches an account itself.</p>';\n    },\n    wht: function () {\n      var l = inv('i7');\n      return '<div class=\"pane-title\"><h3>2307 Certificates</h3></div><p class=\"pane-sub\">Creditable withholding tax certificates owed to us by clients</p>' +\n        '<div class=\"stats\"><div class=\"stat\"><b class=\"num\">' + peso(l.whtStatus === 'RECEIVED' ? 0 : 360) + '</b><span>outstanding</span></div><div class=\"stat\"><b class=\"num\">1</b><span>certificate pending</span></div></div>' +\n        '<div class=\"tbl-wrap\"><table><thead><tr><th>Client / invoice</th><th class=\"r\">Withheld</th><th>Status</th><th></th></tr></thead><tbody><tr>' + clientCell(l) + '<td class=\"r num\">' + peso(l.wht) + '</td><td>' + (l.whtStatus === 'PENDING' ? '<span class=\"pill warn\">Not yet requested</span>' : l.whtStatus === 'REQUESTED' ? '<span class=\"pill info\">Requested today</span>' : '<span class=\"pill good\">Received</span>') + '</td><td class=\"actions\">' + (l.whtStatus === 'PENDING' ? '<button class=\"btn\" data-act=\"wht-request\">Request certificate</button>' : l.whtStatus === 'REQUESTED' ? '<button class=\"btn\" data-act=\"wht-received\">Mark received</button>' : '') + '</td></tr></tbody></table></div>' +\n        '<p class=\"note\" style=\"margin-top:10px\">The request email asks the client for the BIR Form 2307 covering this invoice. Follow up weekly.</p>';\n    },\n    renewals: function () {\n      var tab = S.subtab.ren || 'due';\n      var tabs = [['due', 'Needs action'], ['overdue', 'Lapsed'], ['soon', 'Coming up'], ['all', 'All']];\n      var stageOf = function (r) { return r.days < 0 ? 'overdue' : r.days <= 45 ? 'due' : r.days <= 90 ? 'soon' : 'later'; };\n      var sheet = '';\n      if (S.sheet && S.sheet.kind === 'renew') {\n        sheet = '<div class=\"sheet\"><h4>Tanglaw Agri Ventures renewed</h4><div class=\"fields\"><label class=\"field\">New renewal date<input type=\"date\" id=\"rn-date\" value=\"2027-12-07\"></label><label class=\"field\">Monthly fee<input type=\"number\" id=\"rn-fee\" value=\"18500\"></label><label class=\"field\">Note<input type=\"text\" id=\"rn-note\" value=\"Confirmed by Ms Pascual on the phone\"></label></div><div class=\"actions\"><button class=\"btn primary\" data-act=\"renew-save\">Save</button><button class=\"btn\" data-act=\"sheet-close\">Cancel</button></div></div>';\n      }\n      var rows = S.renewals.filter(function (r) { return tab === 'all' || stageOf(r) === tab; }).map(function (r) {\n        var st = stageOf(r);\n        return '<tr><td class=\"client\"><b>' + esc(r.client) + '</b><small>' + esc(r.product) + ' \u00b7 ' + esc(r.partner) + '</small></td><td><span class=\"pill line\">' + r.entity + '</span></td><td class=\"r num\">' + peso(r.fee) + '</td><td class=\"num\">' + r.ends + '</td><td class=\"r\"><span class=\"pill ' + (st === 'overdue' ? 'bad' : st === 'due' ? 'warn' : 'line') + '\">' + (r.days < 0 ? Math.abs(r.days) + 'd ago' : r.days + 'd') + '</span></td><td>' + (r.outcome ? '<span class=\"pill good\">renewed</span>' : '<span class=\"note\">undecided</span>') + '</td><td class=\"actions\">' + (r.outcome ? '' : '<button class=\"btn primary\" data-act=\"renew-open\" data-id=\"' + r.id + '\"' + (r.id !== 'r1' ? ' disabled title=\"Only Tanglaw is scripted in this sandbox\"' : '') + '>Renewed</button><button class=\"btn\" disabled>Not renewing</button>') + '</td></tr>';\n      }).join('');\n      return '<div class=\"pane-title\"><h3>Renewals</h3></div><p class=\"pane-sub\">Contracts approaching their end date; reminders fire 45 days ahead</p>' + sheet +\n        '<div class=\"subtabs\">' + tabs.map(function (t) { return '<button data-act=\"ren-tab\" data-tab=\"' + t[0] + '\" aria-pressed=\"' + (tab === t[0]) + '\">' + t[1] + '</button>'; }).join('') + '</div>' +\n        '<div class=\"tbl-wrap\"><table><thead><tr><th>Client</th><th>Entity</th><th class=\"r\">Monthly fee</th><th>Renews</th><th class=\"r\">Countdown</th><th>Outcome</th><th></th></tr></thead><tbody>' + (rows || '<tr><td colspan=\"7\" class=\"empty\">Nothing in this group.</td></tr>') + '</tbody></table></div>';\n    }\n  };\n\n  function renderCoach() {\n    var st = currentStep();\n    var bar = '<div class=\"progress\">' + STEPS.map(function (s, i) { return '<i class=\"' + (S.done[s.id] ? 'done' : i === S.step ? 'now' : '') + '\"></i>'; }).join('') + '</div>';\n    if (!st) {\n      try { window.parent.postMessage({ type: 'ar-onboarding', event: 'walkthrough-finished' }, window.location.origin); } catch (e) {}\n      coach.innerHTML = bar + '<p class=\"step-no\">Finished</p><h3>You have done a full day</h3><p class=\"why\">Reminder sent, promise logged, payment recorded, account suspended, certificate requested, renewal recorded. Those eight actions are the job.</p><div class=\"done-msg\">Read the handbook next; the rules section matters most.</div><div class=\"coach-nav\"><a class=\"btn primary\" href=\"#handbook\">Open the handbook</a><button class=\"btn\" data-act=\"restart\">Do it again</button></div>';\n      return;\n    }\n    var done = S.done[st.id];\n    coach.innerHTML = bar + '<p class=\"step-no\">Step ' + (S.step + 1) + ' of ' + STEPS.length + '</p><h3>' + st.title + '</h3><p class=\"why\">' + st.why + '</p>' +\n      (done ? '<div class=\"done-msg\">Done. ' + st.learn[0] + '</div>' : '<div class=\"task\">' + st.task + '</div>') +\n      '<div class=\"coach-nav\">' + (done ? '<button class=\"btn primary\" data-act=\"next\">Next step</button>' : (st.screen && S.screen !== st.screen ? '<button class=\"btn primary\" data-act=\"goto\" data-screen=\"' + st.screen + '\">Take me there</button>' : '') + '<button class=\"btn ghost\" data-act=\"skip\">Skip</button>') + (S.step > 0 ? '<button class=\"btn ghost\" data-act=\"back\">Back</button>' : '') + '</div>' +\n      '<div class=\"learn\"><b>Worth knowing</b><ul>' + st.learn.map(function (l) { return '<li>' + l + '</li>'; }).join('') + '</ul></div>';\n  }\n\n  /* ---------- actions ---------- */\n  function val(id) { var el = document.getElementById(id); return el ? el.value : ''; }\n  document.getElementById('view-walkthrough').addEventListener('click', function (e) {\n    var b = e.target.closest('[data-act], [data-screen]');\n    if (!b || b.disabled) return;\n    var act = b.getAttribute('data-act'), id = b.getAttribute('data-id');\n    S.toast = '';\n    if (!act && b.getAttribute('data-screen')) { S.screen = b.getAttribute('data-screen'); S.visited[S.screen] = true; S.sheet = null; render(); return; }\n    switch (act) {\n      case 'goto': S.screen = b.getAttribute('data-screen'); S.visited[S.screen] = true; S.sheet = null; break;\n      case 'next': S.step = Math.min(S.step + 1, STEPS.length); S.sheet = null; if (STEPS[S.step] && STEPS[S.step].screen) { S.screen = STEPS[S.step].screen; S.visited[S.screen] = true; } break;\n      case 'back': S.step = Math.max(0, S.step - 1); break;\n      case 'skip': S.done[currentStep().id] = true; S.step = Math.min(S.step + 1, STEPS.length); S.sheet = null; if (STEPS[S.step] && STEPS[S.step].screen) { S.screen = STEPS[S.step].screen; S.visited[S.screen] = true; } break;\n      case 'restart': S = fresh(); break;\n      case 'sheet-close': S.sheet = null; break;\n      case 'wl-done': S.worklist.forEach(function (w) { if (w.id === id) w.done = true; }); S.toast = 'Marked done. It stays visible today and drops off tomorrow.'; break;\n      case 'send': S.sheet = { kind: 'send', id: id, level: Number(b.getAttribute('data-level')) }; break;\n      case 'send-confirm': {\n        var t = inv(id), lvl = Number(b.getAttribute('data-level'));\n        t.level = lvl; t.cat = null; S.sheet = null;\n        if (lvl === 4) { t.noticeDaysAgo = 0; S.toast = 'Suspension notice sent to ' + t.email + '. Grace period of 7 days started; the client is now on the Suspensions page.'; }\n        else S.toast = 'Level ' + lvl + ' reminder sent to ' + t.email + ' with the PDF attached. Logged under the invoice.';\n        break;\n      }\n      case 'promise-open': S.screen = 'promises'; S.visited.promises = true; S.sheet = { kind: 'promise', id: id }; break;\n      case 'promise-save': {\n        var t2 = inv(id), date = val('pr-date'), amt = Number(val('pr-amount')) || t2.balance;\n        if (!date) { S.toast = ''; return; }\n        S.promises.push({ id: 'p' + Date.now(), client: t2.client, no: t2.no, date: date, amount: amt, by: val('pr-by') || 'not recorded', channel: val('pr-channel'), kept: false, broken: false });\n        t2.cat = null; S.sheet = null; S.toast = 'Promise logged. Reminders for ' + t2.no + ' pause until ' + date + '.';\n        break;\n      }\n      case 'pay-open': S.sheet = { kind: 'pay', id: id }; break;\n      case 'pay-save': {\n        var t3 = inv(id), amount = Number(val('pay-amount')), method = val('pay-method'), bank = val('pay-bank');\n        var err = document.getElementById('pay-err');\n        if (!(amount > 0)) { err.textContent = 'Enter the amount actually received.'; return; }\n        if (amount > t3.balance + 0.005) { err.textContent = 'That is more than the balance due (' + peso(t3.balance) + ').'; return; }\n        if ((method === 'Bank transfer' || method === 'Cheque') && !bank) { err.textContent = 'Pick the bank account the money landed in.'; return; }\n        if (bank && bank.indexOf(t3.entity) !== 0) { err.textContent = 'That is a ' + bank.slice(0, 4) + ' account; this is an ' + t3.entity + ' invoice.'; return; }\n        t3.balance = Math.round((t3.balance - amount) * 100) / 100;\n        t3.status = t3.balance <= 0 ? 'PAID' : 'PARTIALLY_PAID';\n        if (t3.status === 'PAID') { t3.cat = null; S.worklist.forEach(function (w) { if (w.title === t3.client) w.done = true; }); }\n        S.payments.push({ id: id, amount: amount, method: method, bank: bank });\n        S.sheet = null; S.toast = peso(amount) + ' recorded by ' + method.toLowerCase() + (bank ? ' into ' + bank : '') + '. ' + (t3.status === 'PAID' ? 'Invoice is paid.' : 'Balance due is now ' + peso(t3.balance) + '; it stays on the ladder.');\n        break;\n      }\n      case 'susp-tab': S.subtab.susp = b.getAttribute('data-tab'); break;\n      case 'ren-tab': S.subtab.ren = b.getAttribute('data-tab'); break;\n      case 'suspend-open': S.sheet = { kind: 'suspend' }; break;\n      case 'suspend-confirm': inv('i4').suspended = true; S.subtab.susp = 'suspended'; S.sheet = null; S.toast = 'Recorded as read-only. Audit entry: ACCOUNT_SET_READ_ONLY \u00b7 Dalisay Pharma Distributors.'; break;\n      case 'restore': inv('i4').suspended = false; S.toast = 'Access restored. Audit entry: ACCOUNT_ACCESS_RESTORED.'; break;\n      case 'wht-request': inv('i7').whtStatus = 'REQUESTED'; S.toast = 'Request emailed to Luntian Foods for the 2307 covering BILL NO.0000000809.'; break;\n      case 'wht-received': inv('i7').whtStatus = 'RECEIVED'; S.toast = 'Certificate received. The \u20b1360 credit is now claimable.'; break;\n      case 'renew-open': S.sheet = { kind: 'renew' }; break;\n      case 'renew-save': { var r = S.renewals[0]; r.outcome = 'RENEWED'; r.ends = val('rn-date') || r.ends; r.days = 385; r.fee = Number(val('rn-fee')) || r.fee; S.sheet = null; S.toast = 'Renewal recorded. The contract now renews on ' + r.ends + '; the renewal rate counts it.'; break; }\n      default: return;\n    }\n    render();\n  });\n  document.getElementById('reset-sandbox').addEventListener('click', function () { S = fresh(); render(); });\n\n  /* ---------- checklist ---------- */\n  var CK = [\n    { h: 'By the end of day one', items: ['Finished the walkthrough above', 'Read the handbook, including the rules section', 'Can explain the difference between YOWI and ABBA, and why it matters for bank details', 'Know where the proof-of-payment inbox is and who else reads it', 'Finished onboarding and can open the Follow-up Queue'] },\n    { h: 'By the end of week one', items: ['Shadowed your lead through: a reminder send, a logged promise, a recorded payment', 'Cleared Needs action every morning with your lead watching', 'Added at least three tasks to the Worklist and closed them', 'Read \u201cWhat tonight would send\u201d every afternoon', 'Can name the four rungs of the ladder and their days without looking', 'Know which partners are chased by hand and why'] },\n    { h: 'By the end of week two', items: ['Sent reminders on your own account (Approver access granted)', 'Recorded payments on your own, with the right bank account every time', 'Logged promises for every client who gave a date, with a name on each', 'Chased at least one 2307 certificate to completion', 'Reviewed the Renewals page with your lead and recorded one outcome', 'Flagged, not performed, a read-only suspension'] }\n  ];\n  var ckState = store.get('ar-checklist-v1', {});\n  var ckEl = document.getElementById('checklist');\n  ckEl.innerHTML = CK.map(function (g, gi) {\n    return '<div class=\"ck-group\"><h3>' + g.h + '</h3>' + g.items.map(function (it, ii) { var k = gi + '-' + ii, on = !!ckState[k]; return '<label class=\"' + (on ? 'checked' : '') + '\"><input type=\"checkbox\" id=\"ck-' + k + '\" data-k=\"' + k + '\"' + (on ? ' checked' : '') + '><span>' + it + '</span></label>'; }).join('') + '</div>';\n  }).join('');\n  ckEl.addEventListener('change', function (e) {\n    var i = e.target; if (!i.matches('input[data-k]')) return;\n    ckState[i.getAttribute('data-k')] = i.checked; store.set('ar-checklist-v1', ckState);\n    i.closest('label').classList.toggle('checked', i.checked);\n  });\n\n  route();\n})();\n</script>\n\n</body></html>"